{
	"name": "thelounge-theme-industrial",
	"version": "1.3.0",
	"description": "A 16-color monospaced theme for thelounge, dark by default with a light mode",
	"main": "package.json",
	"license": "MIT",
	"files": [
		"theme.css",
		"theme.scss",
		"_palette.scss",
		"_dark-theme.scss",
		"_light-theme.scss",
		"assets"
	],
	"scripts": {
		"build": "sass --no-source-map theme.scss theme.css && npm run build:debug",
		"build:debug": "sass --no-source-map test/theme-debug.scss test/theme-debug.css",
		"watch": "sass --no-source-map --watch theme.scss:theme.css test/theme-debug.scss:test/theme-debug.css"
	},
	"devDependencies": {
		"sass": "1.102.0"
	},
	"homepage": "https://github.com/z0mbieparade/thelounge-theme-industrial",
	"thelounge": {
		"name": "Industrial",
		"type": "theme",
		"css": "theme.css",
		"themeColor": "#000000"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/z0mbieparade/thelounge-theme-industrial.git"
	},
	"bugs": {
		"url": "https://github.com/z0mbieparade/thelounge-theme-industrial/issues"
	},
	"keywords": [
		"thelounge",
		"thelounge-theme",
		"ASCII",
		"dark",
		"light",
		"16-color",
		"industrial",
		"monospaced"
	]
}
